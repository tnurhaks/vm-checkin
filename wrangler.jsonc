{
  // Konfigurasi Cloudflare Worker: Vendor Management Visitor Check-in
  // "name" WAJIB sama dengan nama Worker di dashboard Cloudflare.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vm-checkin",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  // Pertahankan Variables/Secrets yang diatur melalui dashboard saat deploy.
  "keep_vars": true,
  "observability": {
    "enabled": true
  }
}
